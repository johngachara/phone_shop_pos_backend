# Copy to .env and fill in. Never commit .env.
# The local stack (compose.yml) works with the defaults shown here.

# --- Django ---
# Log to stdout by default; set LOG_FILE to also write a file locally.
LOG_LEVEL=INFO
LOG_FILE=
SECRET_KEY=change-me
# Leave False everywhere except a developer machine.
DEBUG=False
# Set to False only while a server is running on a bare IP with no TLS in front.
# Turn it back on as soon as certificates are installed.
SECURE_SSL_REDIRECT=True
SERVER_URL=
SERVER_IP=

# --- Database (compose: postgres) ---
DB_NAME=postgres
DB_CRED=postgres
DB_PASS=postgres
DB_HOST=localhost
# On Supabase use the session-mode port (5432), not the transaction pooler
# (6543), whenever DB_SCHEMA is set -- see Alltechmanagement/db_schema.py.
DB_PORT=5432
# Confines every table this project owns to one Postgres schema. Leave blank to
# use the connection's default. Required on a Supabase instance shared with
# other applications, where `public` already belongs to something else.
DB_SCHEMA=

# --- Redis (compose: redis) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASS=devredis

# --- Machine-to-machine (scheduler) ---
CELERY_KEY=

# --- Logging (compose.prod.yml only; the web container's docker logging
#     driver, not read by Django) ---
# Grafana Cloud Loki push endpoint with basic auth embedded:
# https://<instance-id>:<api-token-with-logs:write-scope>@logs-prod-XXX.grafana.net/loki/api/v1/push
LOKI_URL=

# --- Email ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GMAIL_RECEIVER=
RESEND_API_KEY=
# Must be on a domain verified in Resend. mail.alltechnyeri.co.ke is verified;
# the bare alltechnyeri.co.ke is not and is rejected with a 403.
RESEND_SENDER_EMAIL=reports@mail.alltechnyeri.co.ke
# Where the daily sales report is sent.

# --- Supabase (identity + data) ---
SUPABASE_URL=
# Service role key. Server-side only -- it bypasses row-level security and can
# rewrite any user's app_metadata, including their role. Never expose to a browser.
SUPABASE_KEY=
# Dashboard -> Settings -> API -> JWT Secret. When set, access tokens are
# verified in-process. When blank, each cold token is verified by calling
# Supabase, which works but adds a network round trip.
SUPABASE_JWT_SECRET=

# --- Passkeys (WebAuthn) ---
# Registered domain, no scheme and no port, e.g. alltechnyeri.co.ke
WEBAUTHN_RP_ID=
# Exact origin the browser reports, e.g. https://pos.alltechnyeri.co.ke
WEBAUTHN_ORIGIN=

# --- AI (NVIDIA NIM) ---
NVIDIA_API_KEY=
# Comma-separated failover chain, primary first. Defaults to models verified to
# support tool calling on this account; others return 404.
NVIDIA_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3.5-lightning-30b-a3b
AI_ATTEMPT_TIMEOUT=45

# --- Firebase (FCM push only; auth is moving to Supabase) ---
# Service-account credentials come from these variables, so no key file has to be
# copied onto a server. Paste the private key with literal \n escapes exactly as
# it appears in the downloaded JSON -- it is unescaped at load time.
# A key_pair.json at the project root is still honoured as a local fallback.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
# Realtime Database URL
DATABASE_URL=
