# Copy to .env and fill in. Never commit .env.
# The local stack (compose.yml) works with the defaults shown here.

# --- Django ---
SECRET_KEY=change-me
# Leave False everywhere except a developer machine.
DEBUG=False
# Set to False only while a server is running on a bare IP with no TLS in front.
# Turn it back on as soon as certificates are installed.
SECURE_SSL_REDIRECT=True
SERVER_URL=
SERVER_IP=

# --- Database (compose: postgres) ---
DB_NAME=postgres
DB_CRED=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Redis (compose: redis) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASS=devredis

# --- Meilisearch (compose: meilisearch) ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=devmasterkey
MEILI_MASTER_KEY=devmasterkey

# --- Machine-to-machine (scheduler) ---
CELERY_KEY=

# --- Email ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GMAIL_RECEIVER=

# --- Supabase (auth + data) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- AI ---
# GITHUB_TOKEN is the outgoing GitHub Models provider, being replaced by NVIDIA NIM.
GITHUB_TOKEN=
NVIDIA_API_KEY=

# --- Firebase (FCM push only; auth is moving to Supabase) ---
# Credentials are read from key_pair.json at the project root, not from these vars.
DATABASE_URL=
